DATABASE_URL="postgresql://user:pass@host:5432/qronus"
APP_URL="https://qronus.example"
SESSION_SECRET="random-64-chars"
PAYMENTS_TEST_MODE="false"
# dev/test only; production admins are set via users.platform_role
ADMIN_EMAILS=""
# Robokassa (RU) — fill only in hosting secrets, never in code
ROBOKASSA_LOGIN=""
ROBOKASSA_PASSWORD1=""
ROBOKASSA_PASSWORD2=""
ROBOKASSA_TEST_PASSWORD1=""
ROBOKASSA_TEST_PASSWORD2=""
# bePaid (BY) — live disabled until contract
BEPAID_SHOP_ID=""
BEPAID_SECRET_KEY=""
BEPAID_LIVE_ENABLED="false"
# SEO verification
YANDEX_VERIFICATION=""
GOOGLE_SITE_VERIFICATION=""
INDEXNOW_KEY=""
YANDEX_METRIKA_ID=""
CRON_SECRET=""
CONTACT_EMAIL=""
DEMO_MODE="true"
# Manual SBP transfers (RU) — used when Robokassa is not configured
SBP_PHONE=""
SBP_BANK=""
SBP_RECIPIENT=""
# Automatic НПД receipts via the owner's "Мой налог" cabinet (enter in hosting settings only)
NALOG_INN=""
NALOG_PASSWORD=""
# Telegram notifications for the owner (see docs/telegram.md)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Platega.io (RU): automatic SBP/card payments; callback URL: <APP_URL>/api/payments/platega/callback
PLATEGA_MERCHANT_ID=""
PLATEGA_SECRET=""
PLATEGA_METHOD="2"
# Explicit live activation requires verified merchant, support and legal operator details.
PLATEGA_LIVE_ENABLED="false"
OWNER_NAME=""
OWNER_TAX_ID=""
OWNER_ADDRESS=""
# Only set DEMO_MODE=false after compliant personal-data hosting and legal review.
# Transactional email (password reset) via Resend; sender domain must be verified there
RESEND_API_KEY=""
EMAIL_FROM=""
